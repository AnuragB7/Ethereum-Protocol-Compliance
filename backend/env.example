# Environment Configuration for Code Analysis Platform
# Copy this file to .env and fill in your values

# =============================================================================
# LLM API Configuration
# =============================================================================
# OpenAI API key (or compatible API)
OPENAI_API_KEY=your-api-key-here
API_KEY=your-api-key-here

# API Base URL (for OpenAI-compatible APIs like Azure, local LLMs)
OPENAI_API_BASE=https://api.openai.com/v1
API_BASE=https://api.openai.com/v1

# Model selection
LLM_MODEL=gpt-4
EMBED_MODEL=text-embedding-ada-002

# =============================================================================
# Server Configuration
# =============================================================================
API_PORT=8000
FRONTEND_PORT=3000

# =============================================================================
# GitHub Integration (for CI/CD and webhooks)
# =============================================================================
# Personal Access Token for posting PR comments
# Required permissions: repo, pull_request:write
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret for verifying incoming webhooks
# Set this in your GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# GitLab Integration (optional)
# =============================================================================
# GitLab API token for posting MR comments
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Webhook token for verifying incoming webhooks
GITLAB_WEBHOOK_TOKEN=your-gitlab-webhook-token

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

